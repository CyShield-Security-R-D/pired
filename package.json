{
  "name": "pired",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Security assessment harness for consultants, as a pi package: engagement workspace, scope gate, security prompt, and record/recall tools, reusing a harness-agnostic core.",
  "license": "MIT",
  "bin": {
    "pired": "./bin/pired.mjs",
    "pired-state": "./bin/pired-state.mjs"
  },
  "files": [
    "bin/",
    "core/",
    "extensions/",
    "skills/",
    "checklists/",
    "themes/",
    "FORMAT.md",
    "README.md",
    "!**/*.test.ts",
    "!core/testing/"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/pired.ts",
      "./extensions/hosts.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run --coverage && npm run --silent assay",
    "assay": "node --experimental-strip-types eval/run.ts",
    "assay:grade": "node --experimental-strip-types eval/grade-cli.ts",
    "assay:experiment": "node --experimental-strip-types eval/experiment-cli.ts",
    "assay:compounding": "node --experimental-strip-types eval/compounding.ts",
    "assay:corpus": "node --experimental-strip-types eval/corpus/fetch.ts",
    "assay:corpus-scan": "node --experimental-strip-types eval/corpus/run.ts",
    "assay:progress": "node --experimental-strip-types eval/progress.ts",
    "assay:field": "node --experimental-strip-types eval/field/run.ts",
    "assay:field-t1": "node --experimental-strip-types eval/field/t1.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
