{
  "name": "pired",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engagement harness for security consultants, as a pi package: engagement workspace, scope gate, security prompt, and record/recall tools, reusing a harness-agnostic core.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/pired.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && npm run --silent assay",
    "assay": "node --experimental-strip-types eval/run.ts",
    "assay:grade": "node --experimental-strip-types eval/grade-cli.ts",
    "assay:experiment": "node --experimental-strip-types eval/experiment-cli.ts",
    "assay:compounding": "node --experimental-strip-types eval/compounding.ts",
    "assay:corpus": "node --experimental-strip-types eval/corpus/fetch.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.2.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
