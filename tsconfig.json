{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "eval/artifacts", "eval/coverage"],
  "include": [
    "core/**/*.ts",
    "bin/**/*.ts",
    "extensions/**/*.ts",
    "eval/**/*.ts",
    "install.test.ts"
  ]
}
